// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  phone      String
  status     Boolean
  ministryId String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model UserSession {
  id                  String   @id @default(cuid())
  sessionId           String
  token               String
  expirationTimestamp Int
  status              Boolean
  userId              String
  updated_at          DateTime @default(now())
  created_at          DateTime @default(now())
}

model Ministry {
  id         String   @id @default(cuid())
  title      String
  updated_at DateTime @default(now())
  created_at DateTime @default(now())
}

model Image {
  id         String   @id @default(cuid())
  title      String
  key        String?
  bucket     String?
  mime       String?
  userId     String?
  ministryId String?  @map("ministryId")
  expire_at  DateTime
  updated_at DateTime @default(now())
  created_at DateTime @default(now())
}

model SlideConfig {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(false)
  duration   Int
  userId     String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model SlideConfigImage {
  id            String @id @default(cuid())
  imageId       String
  slideConfigId String
  position      Int

  @@unique([slideConfigId, position]) // evita imagens duplicadas na mesma posição
}
