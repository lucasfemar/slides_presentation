// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  ministery    String
  password     String
  phone        String
  status       Boolean
  userSessions userSessions[]
  created_at   DateTime       @default(now()) @map(name: "data_criacao")
  update_at    DateTime       @updatedAt @map(name: "data_atualizacao")
  images       images[]
}

model userSessions {
  id                  String  @id @default(cuid())
  sessionId           String
  token               String
  expirationTimestamp Int
  status              Boolean
  user                users   @relation(fields: [userId], references: [id])
  userId              String
}

model images {
  id          String   @id @default(cuid())
  ministry    String
  start_date  DateTime
  expire_date DateTime
  base64      String
  mimetype    String
  active      Boolean
  created_by  String
  user        users    @relation(fields: [created_by], references: [id])
  created_at  DateTime @default(now()) @map(name: "data_criacao")
  update_at   DateTime @updatedAt @map(name: "data_atualizacao")
}
