{
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "dotenv -c '.env' -- node dist/app",
    "dev": "npm run services:up && npm run services:wait:database && npm run prisma:push && dotenv -e .env.development -- tsx watch src/app.ts",
    "prisma:push": "dotenv -e .env.development -- npx prisma db push",
    "prisma:push:reset": "dotenv -e .env.development -- npx prisma db push --force-reset",
    "prisma:studio": "dotenv -e .env.development -- npx prisma studio",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.cjs",
    "lint": "eslint \"src\""
  },
  "dependencies": {
    "@adminjs/express": "^6.1.0",
    "@adminjs/prisma": "^5.0.1",
    "@prisma/client": "^5.6.0",
    "adminjs": "^7.7.2",
    "dotenv": "^17.0.0",
    "dotenv-expand": "^12.0.2",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.17.3",
    "pg": "latest"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "dotenv-cli": "^7.2.1",
    "eslint": "^8.38.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.0",
    "prisma": "^5.6.0",
    "tslib": "^2.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.4"
  },
  "name": "slides_presentation",
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
